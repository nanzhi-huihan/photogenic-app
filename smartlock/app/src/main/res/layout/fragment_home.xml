<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- 顶部状态栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#33000000"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="14sp"
                android:textColor="#F44336"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未连接"
                android:textSize="14sp"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="13sp"
                android:textColor="#CCFFFFFF"/>
        </LinearLayout>

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="智能门禁系统"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Door Lock v2.0"
            android:textSize="13sp"
            android:textColor="#99FFFFFF"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <!-- 门状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_panel"
            android:layout_margin="16dp"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="门状态"
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"/>

                <TextView
                    android:id="@+id/tv_door_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛔ 已关闭"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌡 温度/湿度"
                    android:textSize="11sp"
                    android:textColor="#99FFFFFF"/>

                <TextView
                    android:id="@+id/tv_temp_humi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C / --%"
                    android:textSize="16sp"
                    android:textColor="#4FC3F7"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 连接/断开按钮 -->
        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_connect_btn"
            android:text="🔗 连接蓝牙"
            android:textSize="15sp"
            android:textColor="#FFFFFF"/>

        <!-- 远程开锁按钮 -->
        <Button
            android:id="@+id/btn_unlock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_unlock_btn"
            android:text="🔒 远程开锁"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:enabled="false"/>

        <!-- 五种解锁方式面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐 解锁方式"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- 解锁方式网格 2列 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_method_pwd"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_green"
                    android:text="🔑\n密码"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btn_method_card"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_orange"
                    android:text="💳\n刷卡"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:enabled="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_method_finger"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_green"
                    android:text="👆\n指纹"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btn_method_face"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_orange"
                    android:text="😊\n人脸"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:enabled="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_method_bt"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_green"
                    android:text="📱\n蓝牙APP"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btn_method_button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_orange"
                    android:text="🚪\n出门按钮"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:enabled="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 快捷面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_panel"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_refresh_status"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_green"
                android:text="🔄 刷新状态"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:enabled="false"/>

            <Button
                android:id="@+id/btn_refresh_temp"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_orange"
                android:text="🌡 温湿度"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:enabled="false"/>

            <Button
                android:id="@+id/btn_query_records"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_green"
                android:text="📋 查记录"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:enabled="false"/>
        </LinearLayout>

        <!-- 事件提示 -->
        <TextView
            android:id="@+id/tv_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#FFD54F"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:padding="8dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
